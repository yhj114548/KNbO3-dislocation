##/bin/bash

# =====================================================================
#  Type B screw dislocation in KNbO3 (core-shell) : relax + measure PE
#  b = a<110> (screw), line t = <110>, glide plane {1-10}
#  Reads CONFIG.B produced by make_typeB.py
# =====================================================================

units           metal
atom_style      full      # supports charge + bonds
boundary        p p p
#processors      2 2 2

# read data (dislocation dipole already built into CONFIG.B)
print           "STARTED: no corrected relaxation/MD result yet" file relaxation_B.status screen yes
read_data       CONFIG.B

# allow shear relaxation (dislocations induce shear strain -> triclinic box)
change_box      all triclinic

# ---------- force fields ----------
# Original KNbO3 shell-model coefficients; no additional pair potential.
include         Param_KNO

# ---------- settings ----------
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes one 6000 page 300000

comm_modify     vel yes

# ---------- variable ----------
variable        Tmeas equal 30            # 20-50 K measurement window (Klomp)
variable        Nsettle equal 4000        # original total dynamic settle (2 ps)
variable        Nequil  equal 2e+5        # NPT equilibration        (100 ps)
variable        Nmeas   equal 1e+5        # PE production window       (50 ps)
variable        del_t equal 0.0005        # ps (small step for light shells)

variable        dNout equal 200
variable        dNcfg equal 1000
variable        Tdamp equal 0.1           # ps (absolute, not del_t multiple)
variable        Pdamp equal 1.0           # ps (absolute)
timestep        ${del_t}

# ---------- grouping ----------
group           cores  type 1 2 3
group           shells type 4 5 6

# ---------- thermo ----------
thermo          ${dNout}
thermo_style    custom step time etotal ke pe ebond ecoul temp press vol
thermo_modify   lost error

# ---------- compute ----------
compute         Tcs all temp/cs cores shells
thermo_modify   temp Tcs
compute         Pcs all pressure thermo_temp
thermo_modify   temp Tcs press Pcs

# ---------- 0. constrained static preparation at full physical charges ----------
# Proposed KNbO3 adaptation of Klomp Sec.2.2, not a published parameter set.
# Every stage must pass its force check; failure writes a checkpoint and exits.
include         RELAX_B.in

reset_timestep  0

# ---------- 1. low-temperature dynamics after static convergence ----------
velocity        all set 0.0 0.0 0.0
velocity        all create ${Tmeas} 12345 mom yes rot yes dist gaussian bias yes temp Tcs
velocity        all scale ${Tmeas} bias yes temp Tcs
fix             set all nve
fix             vs  all temp/rescale 1 ${Tmeas} ${Tmeas} 1.0 1.0
fix_modify      vs temp Tcs
run             ${Nsettle}
unfix           vs
unfix           set

# ---------- 2. low-T NPT at zero pressure (relax box + equilibrate) ----------
reset_timestep  0
# Rescale COM motion only; preserve the relative core-shell velocities.
velocity        all scale ${Tmeas} bias yes temp Tcs

fix             1 all npt temp ${Tmeas} ${Tmeas} ${Tdamp} tri 0 0 ${Pdamp} drag 1.0
fix_modify      1 temp Tcs press Pcs

# ---------- remove drift ----------
fix             3 all momentum 100 linear 1 1 1

# ---------- polarization (Pl) : total dipole / volume ----------
# core-shell model: shell displaced from core gives the electronic dipole.
# DIAGNOSTIC ONLY: charge neutrality does not fix the periodic polarization branch.
# This absolute dipole is not a validated spontaneous polarization; compare
# displacements to a matched centrosymmetric reference for that purpose.
#   c_pol[1..3] = Px,Py,Pz [e*Ang];  c_pol[4] = |P|
#   Pl [e/Ang^2] = dipole/volume ;  x16.02 -> C/m^2
compute         pol all dipole
variable        Plx equal c_pol[1]/vol
variable        Ply equal c_pol[2]/vol
variable        Plz equal c_pol[3]/vol
variable        Plmag equal sqrt(v_Plx*v_Plx+v_Ply*v_Ply+v_Plz*v_Plz)
variable        Plx_SI equal v_Plx*16.02       # C/m^2
variable        Ply_SI equal v_Ply*16.02
variable        Plz_SI equal v_Plz*16.02
variable        Plmag_SI equal v_Plmag*16.02

# ---------- dumping ---------
dump		4 cores cfg ${dNcfg} *.cfge mass type xs ys zs id mol q
dump_modify	4 element K Nb O H H H

fix engout all print  ${dNout} "$(step) $(time) $(temp) $(ke) $(pe) $(ebond)" screen no file energy.d
fix strout all print  ${dNout} "$(step) $(time) $(temp) $(pxx) $(pyy) $(pzz) $(press)" screen no file stress.d
fix cllout all print  ${dNout} "$(step) $(time) $(temp) $(vol) $(lx) $(ly) $(lz) $(xy) $(xz) $(yz)" screen no file cell.d
fix polout all print  ${dNout} "$(step) $(time) $(temp) $(v_Plx_SI) $(v_Ply_SI) $(v_Plz_SI) $(v_Plmag_SI)" screen no file pol.d

run             ${Nequil}

# ---------- 3. measure averaged potential energy ----------
variable        natoms equal count(all)
variable        peinst equal pe
fix             avpe all ave/time 10 10000 100000 v_peinst
# also average the polarization magnitude over the production window
fix             avpl all ave/time 10 10000 100000 v_Plmag_SI
run             ${Nmeas}

variable        pe_total    equal f_avpe
variable        pe_per_atom equal f_avpe/${natoms}
variable        Pl_avg      equal f_avpl
print           "RESULT typeB N=${natoms} pe_total=${pe_total} pe_per_atom=${pe_per_atom} Pl_Cm2=${Pl_avg}" &
                file pe_typeB.dat screen yes

write_data      CONFIG.B_relaxed
print           "MD_COMPLETE: inspect structure, internal KE and equilibration before interpretation" append relaxation_B.status screen yes
